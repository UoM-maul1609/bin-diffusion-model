&run_vars
    ! Dedicated configuration for matlab/plot_bdm_simulation.m.
    ! Keep the ordinary namelist.in unchanged.
    outputfile = '/tmp/output3.nc',
    bin_model_file = 'namelist.diffusion',
    diffusion_model_file = 'mbd/namelist.in',
    diffusion_coeff_file = 'namelist.diff_coeffs',

    ! The reference bdm_simulation.png is the constant-diffusivity test.
    ! nmd%d_coeff is read from mbd/namelist.in (currently 1.e-17 m2 s-1).
    diffusion_type = 0,

    ! 0: equilibrium from particle-average water activity
    ! 1: equilibrium from the water activity in the outermost shell
    koehler_shell_flag = 1,
/
